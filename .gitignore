# Secrets — never commit
.env
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/

# Data (too large for git or contains call records)
data/processed/
data/HARD-Arabic-Dataset-master/
data/calls/*.json
!data/calls/.gitkeep

# Large legacy DL binaries & split datasets (keep notebooks, metrics & archive/README.md)
archive/**/*.keras
archive/**/*.npy
archive/**/*.npz
archive/**/*.joblib
archive/data_processed/*.csv

# Benchmark output
results/benchmarks/

# Vercel local state
.vercel/

# Frontend build (if applicable)
frontend/node_modules/
frontend/dist/

# Notebook checkpoints
.ipynb_checkpoints/

# Pytest cache
.pytest_cache/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
