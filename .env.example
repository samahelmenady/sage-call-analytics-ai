# ---------------------------------------------------------------
# Sage v2.0 — environment variable reference
# Copy this file to .env and fill in your API key(s).
# Never commit .env to GitHub!
# ---------------------------------------------------------------

# ── STT (Cohere Transcribe) ────────────────────────────────────
COHERE_API_KEY=
STT_PROVIDER=cohere
STT_MODEL=cohere-transcribe-arabic-07-2026
STT_LANGUAGE=ar

# ── GenAI Analysis ─────────────────────────────────────────────
# Options: "auto" (prefers Gemini if GEMINI_API_KEY is set, else Cohere),
#          "gemini", or "cohere"
GENAI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
COHERE_GENAI_MODEL=command-r-plus-08-2024
# Optional explicit override for active GenAI model:
GENAI_MODEL=

# ── Server ─────────────────────────────────────────────────────
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# ── Analysis Limits ────────────────────────────────────────────
MAX_TRANSCRIPT_CHARS=50000
ANALYSIS_TIMEOUT_SECONDS=60
DEFAULT_LANGUAGE=ar

# ── Testing ────────────────────────────────────────────────────
INTEGRATION_TESTS=false
